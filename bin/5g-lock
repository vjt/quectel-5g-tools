#!/usr/bin/env lua
-- 5g-lock: Lock Quectel modem to specific bands and cells from UCI config

package.path = "/usr/lib/lua/?.lua;/usr/lib/lua/?/init.lua;" .. package.path

local quectel = require("quectel")
local utils = quectel.utils
local guard = require("quectel.lock_guard")
local quectel_uci = require("quectel.uci")

--- Log to syslog. A rollback happens unattended, often at boot, and has
--- to leave a trace someone can find afterwards.
local function log(fmt, ...)
    local msg = string.format(fmt, ...)
    local p = io.popen("logger -t 5g-lock", "w")
    if p then p:write(msg); p:close() end
    print(msg)
end

-- Records a cell list that stranded the radio. Lives in /etc because it
-- has to outlive the reboot that clears the lock — /var/run is tmpfs,
-- and the whole point is to stop the next boot re-applying the same
-- list. See quectel.lock_guard.should_skip_boot_apply.
local FAIL_MARKER = "/etc/5g-cell-lock.failed"

local function cells_signature(cells)
    local parts = {}
    for _, c in ipairs(cells or {}) do
        table.insert(parts, string.format("%d,%d", c.earfcn, c.pci))
    end
    return table.concat(parts, " ")
end

local function write_fail_marker(sig)
    local f = io.open(FAIL_MARKER, "w")
    if f then f:write(sig, "\n"); f:close() end
end

local function clear_fail_marker()
    os.remove(FAIL_MARKER)
end

--- Decoded `ifstatus <iface>`, or nil when it cannot be read.
local function ifstatus(iface)
    local jsonc_ok, jsonc = pcall(require, "luci.jsonc")
    if not jsonc_ok then return nil end
    local h = io.popen(string.format("ifstatus %s 2>/dev/null", iface), "r")
    if not h then return nil end
    local out = h:read("*a") or ""
    h:close()
    if out == "" then return nil end
    return jsonc.parse(out)
end

--- Watch for service after a lock has been applied, and clear the lock
--- if it never arrives.
---
--- A cell lock pins the modem to a whitelist. If every cell on it goes
--- unreachable the modem has nowhere to reselect to and there is no
--- service at all — which is exactly what happened on 2026-09-04, for
--- ~14 minutes. What rescued it then was that cell locks do not survive
--- a reboot; now that we re-apply them at boot, that is gone, so the
--- lock has to be able to undo itself.
local function verify_or_rollback(modem, verify_seconds, iface, sig)
    if verify_seconds <= 0 then
        log("verification disabled (lock_verify_seconds=0) — keeping the lock unconditionally")
        return
    end

    log("verifying: waiting up to %ds for service on %s", verify_seconds, iface)
    local t0 = utils.now()
    local service_seen = false

    while true do
        service_seen = guard.service_ok(ifstatus(iface))
        local elapsed = math.floor(utils.now() - t0)
        if service_seen then
            log("service up after %ds — lock verified, keeping it", elapsed)
            clear_fail_marker()
            return
        end
        if guard.should_rollback({
                elapsed = elapsed,
                verify_seconds = verify_seconds,
                service_seen = service_seen }) then
            log("NO service %ds after applying the cell lock — clearing it "
                .. "so the modem can reselect freely", elapsed)
            -- Record the list that stranded us BEFORE trying to clear.
            -- Clearing can fail outright (+CME ERROR 904 was observed on
            -- a radio too far gone to take the command), and it is
            -- exactly that case where the next boot must not re-apply.
            write_fail_marker(sig)
            if modem:clear_cell_lock("common/4g") then
                log("cell lock cleared; lte_cells left in UCI, and this list "
                    .. "is recorded in %s so the next boot will not re-apply "
                    .. "it — edit the list to try again", FAIL_MARKER)
            else
                log("could NOT clear the cell lock (the radio refused the "
                    .. "command); reboot to drop it. This list is recorded "
                    .. "in %s so the next boot will not re-apply it",
                    FAIL_MARKER)
            end
            return
        end
        utils.sleep(5)
    end
end

local function print_usage()
    print("Usage: 5g-lock [OPTION]")
    print("")
    print("Lock Quectel modem to bands and cells configured in UCI.")
    print("")
    print("Options:")
    print("  --apply       Apply band and cell lock configuration from UCI")
    print("  --reset       Clear all band and cell locks")
    print("  --wait=SECS   Wait SECS seconds before applying (use with --apply)")
    print("  --verify      After applying, wait for service and clear the")
    print("                cell lock if none appears (use with --apply).")
    print("                Window: quectel.modem.lock_verify_seconds.")
    print("  --help        Show this help")
    print("")
    print("With no options, shows current lock status.")
    print("")
    print("UCI configuration (in /etc/config/quectel):")
    print("  config modem 'modem'")
    print("    list lte_bands '1'")
    print("    list lte_bands '3'")
    print("    list nr5g_bands '78'")
    print("    list lte_cells '275,280'        # earfcn,pci")
    print("    list nr5g_cells '920,648768,15,78'  # pci,arfcn,scs,band")
    print("")
    print("Note: Band locks persist across reboots. Cell locks do NOT.")
end

local function print_band_status(modem)
    local mode = modem:get_band_config("mode_pref")
    print(string.format("  Mode: %s", mode or "?"))

    local lte = modem:get_band_config("lte_band")
    if type(lte) == "table" then
        print(string.format("  LTE bands: %s", table.concat(lte, ":")))
    else
        print(string.format("  LTE bands: %s", lte or "?"))
    end

    local nr = modem:get_band_config("nsa_nr5g_band")
    if type(nr) == "table" then
        print(string.format("  5G NR bands: %s", table.concat(nr, ":")))
    else
        print(string.format("  5G NR bands: %s", nr or "?"))
    end
end

local function print_cell_lock_status(modem)
    local lte_lock = modem:get_cell_lock("common/4g")
    if lte_lock and lte_lock.num_cells > 0 then
        local parts = {}
        for _, cell in ipairs(lte_lock.cells) do
            table.insert(parts, string.format("EARFCN %d PCI %d", cell.earfcn, cell.pci))
        end
        print(string.format("  LTE cell lock: %s", table.concat(parts, ", ")))
    else
        print("  LTE cell lock: none")
    end

    local nr_lock = modem:get_cell_lock("common/5g")
    if nr_lock and nr_lock.num_cells > 0 then
        local parts = {}
        for _, cell in ipairs(nr_lock.cells) do
            table.insert(parts, string.format("PCI %d ARFCN %d SCS %d Band %d",
                cell.pci, cell.arfcn, cell.scs, cell.band))
        end
        print(string.format("  5G NR cell lock: %s", table.concat(parts, ", ")))
    else
        print("  5G NR cell lock: none")
    end
end

local function print_status(modem)
    print("Current lock status:")
    print("")
    print_band_status(modem)
    print("")
    print_cell_lock_status(modem)
end

-- Parse arguments
local action = "status"
local wait_seconds = 0
local verify = false

for i = 1, #arg do
    local a = arg[i]
    if a == "--apply" then
        action = "apply"
    elseif a == "--reset" then
        action = "reset"
    elseif a:match("^--wait=") then
        wait_seconds = tonumber(a:match("^--wait=(%d+)")) or 0
    elseif a == "--verify" then
        verify = true
    elseif a == "--help" or a == "-h" then
        print_usage()
        os.exit(0)
    else
        io.stderr:write("Unknown option: " .. a .. "\n")
        print_usage()
        os.exit(1)
    end
end

-- Connect to modem.
--
-- Deliberately patient, unlike the pollers: this is a one-shot action a
-- person (or the boot-time init script) asked for, and failing it
-- because 5g-led-bars happened to be mid-poll is useless behaviour. The
-- wait is longer than quectel.lock's hold ceiling, so no holder can
-- keep us out — at worst we wait for the ceiling to expire and reclaim.
-- Contention is heaviest precisely when the init script runs, with
-- every daemon starting at once.
local lock_ceiling = quectel_uci.get_number(
    "quectel", "modem", "lock_max_hold_seconds", 15)
local config = quectel.load_config()
local modem = quectel.modem.new(config.device, config.timeout,
                                (lock_ceiling + 5) * 1000,
                                config.cache_ttl, lock_ceiling)
local ok, err = modem:open()
if not ok then
    io.stderr:write("Error: " .. tostring(err) .. "\n")
    os.exit(1)
end

if action == "status" then
    print_status(modem)
    modem:close()
    os.exit(0)
end

if action == "reset" then
    print("Resetting all locks...")
    print("")

    -- Reset bands
    if modem:set_bands("lte_band", {}) then
        print("  LTE bands: reset to all")
    else
        io.stderr:write("  Failed to reset LTE bands\n")
    end

    if modem:set_bands("nsa_nr5g_band", {}) then
        print("  5G NR bands: reset to all")
    else
        io.stderr:write("  Failed to reset 5G NR bands\n")
    end

    -- Clear cell locks (only if active)
    local lte_lock = modem:get_cell_lock("common/4g")
    if lte_lock and lte_lock.num_cells > 0 then
        if modem:clear_cell_lock("common/4g") then
            print("  LTE cell lock: cleared")
        else
            io.stderr:write("  Failed to clear LTE cell lock\n")
        end
    else
        print("  LTE cell lock: none")
    end

    local nr_lock = modem:get_cell_lock("common/5g")
    if nr_lock and nr_lock.num_cells > 0 then
        if modem:clear_cell_lock("common/5g") then
            print("  5G NR cell lock: cleared")
        else
            io.stderr:write("  Failed to clear 5G NR cell lock\n")
        end
    else
        print("  5G NR cell lock: none")
    end

    print("")
    print_status(modem)
    modem:close()
    os.exit(0)
end

if action == "apply" then
    -- Wait if requested
    if wait_seconds > 0 then
        print(string.format("Waiting for %d seconds...", wait_seconds))
        utils.sleep(wait_seconds)
    end

    local config = quectel.load_config()

    local has_bands = config.lte_bands or config.nr5g_bands
    local has_cells = (config.lte_cells and #config.lte_cells > 0) or
                      (config.nr5g_cells and #config.nr5g_cells > 0)

    if not has_bands and not has_cells then
        print("No lock configuration found in UCI.")
        print("")
        print("Configure bands:")
        print("  uci add_list quectel.modem.lte_bands='1'")
        print("  uci add_list quectel.modem.nr5g_bands='78'")
        print("")
        print("Configure cell locks:")
        print("  uci add_list quectel.modem.lte_cells='275,280'")
        print("  uci add_list quectel.modem.nr5g_cells='920,648768,15,78'")
        print("")
        print("  uci commit quectel")
    end

    print("")
    print("Applying lock configuration from UCI...")
    print("")

    -- Band locks: apply if configured, reset to all if not
    if config.lte_bands then
        local band_str = table.concat(config.lte_bands, ":")
        print(string.format("  LTE bands: %s", band_str))

        if modem:set_bands("lte_band", config.lte_bands) then
            print("    OK")
        else
            io.stderr:write("    Failed\n")
        end
    else
        if modem:set_bands("lte_band", {}) then
            print("  LTE bands: reset to all")
        else
            io.stderr:write("  Failed to reset LTE bands\n")
        end
    end

    if config.nr5g_bands then
        local band_str = table.concat(config.nr5g_bands, ":")
        print(string.format("  5G NR bands: %s", band_str))

        if modem:set_bands("nsa_nr5g_band", config.nr5g_bands) then
            print("    OK")
        else
            io.stderr:write("    Failed\n")
        end
    else
        if modem:set_bands("nsa_nr5g_band", {}) then
            print("  5G NR bands: reset to all")
        else
            io.stderr:write("  Failed to reset 5G NR bands\n")
        end
    end

    -- Cell locks: apply if configured, clear if not
    if config.lte_cells and #config.lte_cells > 0 then
        local parts = {}
        for _, cell in ipairs(config.lte_cells) do
            table.insert(parts, string.format("EARFCN %d PCI %d", cell.earfcn, cell.pci))
        end
        print(string.format("  LTE cell lock: %s", table.concat(parts, ", ")))

        local cells_ok, offender = guard.validate_cells(config.lte_cells)
        if not cells_ok then
            io.stderr:write(string.format(
                "Refusing to apply: %s,%s is not a valid LTE cell "
                .. "(EARFCN 0-262143, PCI 0-503). Locking to an out-of-range "
                .. "cell does not fail cleanly — the modem stores a corrupt "
                .. "entry, strands the radio and then refuses to clear it.\n",
                tostring(offender and offender.earfcn),
                tostring(offender and offender.pci)))
            modem:close()
            os.exit(1)
        end
        if modem:set_cell_lock_4g(config.lte_cells) then
            print("    OK")
        else
            io.stderr:write("    Failed\n")
        end
    else
        local lte_lock = modem:get_cell_lock("common/4g")
        if lte_lock and lte_lock.num_cells > 0 then
            if modem:clear_cell_lock("common/4g") then
                print("  LTE cell lock: cleared")
            else
                io.stderr:write("  Failed to clear LTE cell lock\n")
            end
        else
            print("  LTE cell lock: none")
        end
    end

    if config.nr5g_cells and #config.nr5g_cells > 0 then
        local cell = config.nr5g_cells[1]
        print(string.format("  5G NR cell lock: PCI %d ARFCN %d SCS %d Band %d",
            cell.pci, cell.arfcn, cell.scs, cell.band))

        if modem:set_cell_lock_5g(config.nr5g_cells) then
            print("    OK")
        else
            io.stderr:write("    Failed\n")
        end
    else
        local nr_lock = modem:get_cell_lock("common/5g")
        if nr_lock and nr_lock.num_cells > 0 then
            if modem:clear_cell_lock("common/5g") then
                print("  5G NR cell lock: cleared")
            else
                io.stderr:write("  Failed to clear 5G NR cell lock\n")
            end
        else
            print("  5G NR cell lock: none")
        end
    end

    print("")
    print_status(modem)

    -- A lock re-applied at every boot is a lock a reboot cannot clear,
    -- so it has to be able to clear itself.
    if verify then
        local verify_seconds = quectel_uci.get_number(
            "quectel", "modem", "lock_verify_seconds", 120)
        local iface = quectel_uci.get_string(
            "quectel", "watchdog", "bearer_iface", "wwan")
        print("")
        verify_or_rollback(modem, verify_seconds, iface,
                           cells_signature(config.lte_cells))
    end

    modem:close()
    os.exit(0)
end
