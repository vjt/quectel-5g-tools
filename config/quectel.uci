config modem 'modem'
	option device '/dev/ttyUSB2'
	option baudrate '115200'
	option timeout '2.0'
	option refresh_interval '5.0'
	# how long a read-only AT reply may be shared between the tools
	# (collector, led-bars, ad-hoc CLI) before it is re-read from the
	# modem. Collapses their overlapping poll timers onto one AT
	# round-trip so they stop racing for the serial lock. 0 = never
	# share. The watchdog always reads fresh regardless.
	#
	# Must exceed the prometheus scrape interval (10s), or the cache
	# never hits: at 5s every scrape missed, so every scrape took the
	# lock. That is the pressure that starved the watchdog.
	option cache_ttl '15'
	# max wait for /var/lock/quectel-modem.lock before giving up
	option lock_wait_ms '2000'
	# Ceiling on how long any one process may hold the modem lock before
	# a waiter reclaims it. Nothing else bounds a holder hung on an
	# unresponsive port — and a dead holder whose PID has been recycled
	# to a live process looks alive forever to kill(pid,0). That is how
	# the port stayed locked from 2026-08-13 to 09-01, until the reboot
	# for the r7 flash wiped tmpfs. Sits well above the slowest
	# legitimate hold (two AT commands at the 2s timeout) and below every
	# poll interval. 5g-watchdog deliberately waits longer than this
	# ceiling, so it can never be starved.
	option lock_max_hold_seconds '15'
	option beep_interval '0.6'
	option beeps_enabled '1'
	list lte_bands '1'
	list lte_bands '3'
	list lte_bands '7'
	list lte_bands '20'
	list nr5g_bands '78'
#	list lte_cells '275,280'
#	list lte_cells '1350,427'
#	list nr5g_cells '920,648768,15,78'

config led_bars 'led_bars'
	option enabled '1'
	option interval '10'

config watchdog 'watchdog'
	option enabled '1'
	option poll_interval '60'
	option degraded_samples '5'
	# how long to wait after a recovery action for NR to reattach before
	# calling it a failure. 60s is too tight in marginal cells (NR
	# sometimes returns at 90–150s).
	option recovery_wait_seconds '180'
	# cooldown after a successful recovery — give the cell a chance to
	# settle before we test it again
	option cooldown_ok '300'
	# cooldown after a failed cycle; doubles each consecutive failure up
	# to cooldown_fail_max (30min). Resets on next success / cell-driven
	# recovery.
	option cooldown_fail '300'
	option cooldown_fail_max '1800'
	# interface the bearer lives on — recovery is ifdown/ifup on this
	option bearer_iface 'wwan'
	# Telegram alerts (opt-in: leave token/chat empty to disable). Each
	# trigger is independently disabled by setting it to 0.
	option alert_after_failed '0'
	option alert_detach_seconds '0'
	# alert when the modem stops answering AT for this long. Unlike the
	# two above this is on by default: a mute AT port is invisible from
	# the outside — the data plane keeps working — and went unnoticed
	# for 20 days on 2026-08-12 because nothing watched for it.
	option alert_probe_fail_seconds '900'
	option telegram_token ''
	option telegram_chat ''
	# Last resort for a mute AT port: reboot, but ONLY if the data plane
	# is down too. A mute port with a working bearer costs telemetry, not
	# connectivity, and is not worth dropping every client for — the
	# alert above covers that case. A host reboot is the only thing known
	# to clear this (USB re-enumeration and a 5G_reset GPIO pulse were
	# both tried on 2026-09-02 and failed; the GPIO pulse additionally
	# wedged PCIe). 0 disables.
	option at_mute_reboot_seconds '1800'
	# never auto-reboot more than once per this window, nor within
	# boot_grace of coming up — together these stop a modem that is mute
	# from boot from turning the router into a reboot loop.
	option reboot_min_interval_seconds '86400'
	option reboot_boot_grace_seconds '900'
