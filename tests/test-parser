#!/usr/bin/env lua
-- Test script for the QCAINFO parser
-- Verifies correct parsing of all QCAINFO formats

-- Working tree first: without this the suite silently validates whatever
-- version of the package happens to be installed in /usr/lib/lua on the
-- machine running it, and local edits go untested.
package.path = "lua/?.lua;lua/?/init.lua;/usr/lib/lua/?.lua;/usr/lib/lua/?/init.lua;" .. package.path

local parser = require("quectel.parser")
local utils = require("quectel.utils")

local passed = 0
local failed = 0

local function test(name, condition)
    if condition then
        print(string.format("  [OK] %s", name))
        passed = passed + 1
    else
        print(string.format("  [FAIL] %s", name))
        failed = failed + 1
    end
end

print("=== Testing QCAINFO Parser ===")
print("")

-- Test 1: PCC with 10 fields
print("Test 1: PCC (10 fields)")
local pcc_sample = '+QCAINFO: "PCC",1350,100,"LTE BAND 3",1,427,-94,-15,-58,-1\n\nOK'
local result = parser.parse_qcainfo(pcc_sample)
test("PCC parsed", result.pcc ~= nil)
test("PCC pci=427", result.pcc and result.pcc.pci == 427)
test("PCC band=3", result.pcc and result.pcc.band == 3)
test("PCC rsrp=-94", result.pcc and result.pcc.rsrp == -94)
test("PCC rssnr=-1", result.pcc and result.pcc.rssnr == -1)
test("PCC state=1", result.pcc and result.pcc.state == 1)
print("")

-- Test 2: SCC with 5 fields (NR5G)
print("Test 2: SCC NR5G (5 fields)")
local nr5g_sample = '+QCAINFO: "SCC",648768,10,"NR5G BAND 78",697\n\nOK'
result = parser.parse_qcainfo(nr5g_sample)
test("SCC parsed", #result.scc == 1)
test("SCC pci=697", result.scc[1] and result.scc[1].pci == 697)
test("SCC band=78", result.scc[1] and result.scc[1].band == 78)
test("SCC rat=5g", result.scc[1] and result.scc[1].rat == "5g")
test("SCC arfcn=648768", result.scc[1] and result.scc[1].arfcn == 648768)
print("")

-- Test 3: SCC with 13 fields (full LTE)
print("Test 3: SCC LTE full (13 fields)")
local scc13_sample = '+QCAINFO: "SCC",275,75,"LTE BAND 1",1,406,-102,-20,-74,-10,0,-,-\n\nOK'
result = parser.parse_qcainfo(scc13_sample)
test("SCC parsed", #result.scc == 1)
test("SCC pci=406", result.scc[1] and result.scc[1].pci == 406)
test("SCC band=1", result.scc[1] and result.scc[1].band == 1)
test("SCC rsrp=-102", result.scc[1] and result.scc[1].rsrp == -102)
test("SCC rsrq=-20", result.scc[1] and result.scc[1].rsrq == -20)
test("SCC rssnr=-10", result.scc[1] and result.scc[1].rssnr == -10)
test("SCC state=1", result.scc[1] and result.scc[1].state == 1)
print("")

-- Test 4: SCC with 9 fields (no signal)
print("Test 4: SCC LTE no signal (9 fields)")
local scc9_sample = '+QCAINFO: "SCC",1500,50,"LTE BAND 7",2,123,1,B20,6200\n\nOK'
result = parser.parse_qcainfo(scc9_sample)
test("SCC parsed", #result.scc == 1)
test("SCC pci=123", result.scc[1] and result.scc[1].pci == 123)
test("SCC state=2", result.scc[1] and result.scc[1].state == 2)
test("SCC ul_configured=1", result.scc[1] and result.scc[1].ul_configured == 1)
test("SCC ul_band=B20", result.scc[1] and result.scc[1].ul_band == "B20")
test("SCC ul_earfcn=6200", result.scc[1] and result.scc[1].ul_earfcn == 6200)
test("SCC rsrp=nil", result.scc[1] and result.scc[1].rsrp == nil)
print("")

-- Test 5: SCC with 12 fields
print("Test 5: SCC LTE with signal (12 fields)")
local scc12_sample = '+QCAINFO: "SCC",1500,50,"LTE BAND 7",2,123,1,B20,6200,-95,-12,-5\n\nOK'
result = parser.parse_qcainfo(scc12_sample)
test("SCC parsed", #result.scc == 1)
test("SCC pci=123", result.scc[1] and result.scc[1].pci == 123)
test("SCC state=2", result.scc[1] and result.scc[1].state == 2)
test("SCC rsrp=-95", result.scc[1] and result.scc[1].rsrp == -95)
test("SCC rsrq=-12", result.scc[1] and result.scc[1].rsrq == -12)
test("SCC rssnr=-5", result.scc[1] and result.scc[1].rssnr == -5)
print("")

-- Test 6: Mixed response (like real modem output)
print("Test 6: Mixed response from CLAUDE.md")
local mixed_sample = [[
+QCAINFO: "PCC",275,75,"LTE BAND 1",1,280,-99,-14,-67,-4
+QCAINFO: "SCC",1350,100,"LTE BAND 3",1,240,-95,-18,-68,-10,0,-,-
+QCAINFO: "SCC",648768,10,"NR5G BAND 78",920

OK
]]
result = parser.parse_qcainfo(mixed_sample)
test("PCC parsed", result.pcc ~= nil)
test("PCC pci=280", result.pcc and result.pcc.pci == 280)
test("PCC band=1", result.pcc and result.pcc.band == 1)
test("2 SCCs parsed", #result.scc == 2)
test("SCC1 pci=240", result.scc[1] and result.scc[1].pci == 240)
test("SCC1 band=3", result.scc[1] and result.scc[1].band == 3)
test("SCC2 pci=920", result.scc[2] and result.scc[2].pci == 920)
test("SCC2 band=78", result.scc[2] and result.scc[2].band == 78)
test("SCC2 rat=5g", result.scc[2] and result.scc[2].rat == "5g")
print("")

-- Test 7: User's actual output
print("Test 7: User's actual modem output")
local user_sample = [[
+QCAINFO: "PCC",1350,100,"LTE BAND 3",1,427,-94,-15,-58,-1
+QCAINFO: "SCC",275,75,"LTE BAND 1",1,406,-102,-20,-74,-10,0,-,-
+QCAINFO: "SCC",648768,10,"NR5G BAND 78",697

OK
]]
result = parser.parse_qcainfo(user_sample)
test("PCC parsed", result.pcc ~= nil)
test("PCC pci=427 (not 1)", result.pcc and result.pcc.pci == 427)
test("SCC1 pci=406 (not 1)", result.scc[1] and result.scc[1].pci == 406)
test("SCC2 pci=697", result.scc[2] and result.scc[2].pci == 697)
print("")

-- Test 8: Serving cell - two-line format (LTE + NR5G)
print("Test 8: Serving cell two-line format")
local sc_two_line = [[
+QENG: "servingcell","NOCONN"
+QENG: "LTE","FDD",222,01,328261F,280,275,1,4,4,BE3,-99,-14,-66,7,4,30,-
+QENG: "NR5G-NSA",222,01,920,-96,18,-10,648768,78,10,1

OK
]]
result = parser.parse_serving_cell(sc_two_line)
test("state=NOCONN", result.state == "NOCONN")
test("LTE parsed", result.lte ~= nil)
test("LTE pci=280", result.lte and result.lte.pci == 280)
test("LTE band=1", result.lte and result.lte.band == 1)
test("LTE arfcn=275", result.lte and result.lte.arfcn == 275)
test("LTE sinr=7", result.lte and result.lte.sinr == 7)
test("NR5G parsed", result.nr5g ~= nil)
test("NR5G pci=920", result.nr5g and result.nr5g.pci == 920)
test("NR5G band=78", result.nr5g and result.nr5g.band == 78)
test("NR5G sinr=18", result.nr5g and result.nr5g.sinr == 18)
print("")

-- Test 9: Serving cell - single-line format (LTE only)
print("Test 9: Serving cell single-line format (LTE only)")
local sc_single = [[
+QENG: "servingcell","NOCONN","LTE","FDD",222,01,4940206,427,1350,3,5,5,BFF,-93,-11,-61,11,7,50,-

OK
]]
result = parser.parse_serving_cell(sc_single)
test("state=NOCONN", result.state == "NOCONN")
test("LTE parsed", result.lte ~= nil)
test("LTE pci=427", result.lte and result.lte.pci == 427)
test("LTE band=3", result.lte and result.lte.band == 3)
test("LTE arfcn=1350", result.lte and result.lte.arfcn == 1350)
test("LTE sinr=11", result.lte and result.lte.sinr == 11)
test("LTE rsrp=-93", result.lte and result.lte.rsrp == -93)
test("LTE cell_id=4940206", result.lte and result.lte.cell_id == "4940206")
test("LTE duplex=FDD", result.lte and result.lte.duplex == "FDD")
test("NR5G nil", result.nr5g == nil)
print("")

-- Test 10: parse_qnwprefcfg_from (multi-line ue_capability_band)
print("Test 10: parse_qnwprefcfg_from (ue_capability_band)")
local ue_cap_sample = [[
+QNWPREFCFG: "gw_band",1:8
+QNWPREFCFG: "lte_band",1:3:7:8:20:28:32:38:40:41:42
+QNWPREFCFG: "nsa_nr5g_band",1:3:7:28:41:77:78:79
+QNWPREFCFG: "nr5g_band",1:3:7:28:41:77:78:79

OK
]]
local setting, bands = parser.parse_qnwprefcfg_from(ue_cap_sample, "lte_band")
test("setting=lte_band", setting == "lte_band")
test("11 LTE bands", bands and #bands == 11)
test("first band=1", bands and bands[1] == 1)
test("last band=42", bands and bands[#bands] == 42)

setting, bands = parser.parse_qnwprefcfg_from(ue_cap_sample, "nsa_nr5g_band")
test("setting=nsa_nr5g_band", setting == "nsa_nr5g_band")
test("8 NR5G bands", bands and #bands == 8)
test("includes band 78", bands and bands[7] == 78)
print("")

-- Standalone-NR samples below are real RM520N output from a T-Mobile US
-- (310/260) device, reported in vjt/openwrt-glinet-x3000#1. SA field
-- order differs from NSA, so these pin it down.
print("Test 11: Serving cell NR5G-SA single-line")
local sa_single = [[
+QENG: "servingcell","NOCONN","NR5G-SA","FDD",310,260,1C5EC3016,484,2F8D00,396250,25,3,-108,-10,15,0,-

OK
]]
result = parser.parse_serving_cell(sa_single)
test("mode=SA", result.mode == "SA")
test("state=NOCONN", result.state == "NOCONN")
test("no LTE anchor", result.lte == nil)
test("nr5g parsed", result.nr5g ~= nil)
test("mcc=310", result.nr5g and result.nr5g.mcc == 310)
test("mnc=260", result.nr5g and result.nr5g.mnc == 260)
test("cell_id=1C5EC3016", result.nr5g and result.nr5g.cell_id == "1C5EC3016")
test("pci=484", result.nr5g and result.nr5g.pci == 484)
test("tac=2F8D00", result.nr5g and result.nr5g.tac == "2F8D00")
test("arfcn=396250", result.nr5g and result.nr5g.arfcn == 396250)
test("band=25", result.nr5g and result.nr5g.band == 25)
test("rsrp=-108", result.nr5g and result.nr5g.rsrp == -108)
test("rsrq=-10", result.nr5g and result.nr5g.rsrq == -10)
test("sinr=15", result.nr5g and result.nr5g.sinr == 15)
test("scs=0", result.nr5g and result.nr5g.scs == 0)
print("")

print("Test 12: Serving cell NR5G-SA two-line")
local sa_two_line = [[
+QENG: "servingcell","NOCONN"
+QENG: "NR5G-SA","FDD",310,260,1C5EC3016,484,2F8D00,396250,25,3,-108,-10,15,0,-

OK
]]
result = parser.parse_serving_cell(sa_two_line)
test("mode=SA", result.mode == "SA")
test("state=NOCONN", result.state == "NOCONN")
test("pci=484", result.nr5g and result.nr5g.pci == 484)
test("rsrp=-108", result.nr5g and result.nr5g.rsrp == -108)
test("sinr=15", result.nr5g and result.nr5g.sinr == 15)
print("")

print("Test 13: NSA field order unchanged by SA support")
local nsa_sample = [[
+QENG: "servingcell","NOCONN","LTE","FDD",222,01,4940206,427,1350,3,5,5,BFF,-93,-11,-61,11,7,50,-
+QENG: "NR5G-NSA",222,01,920,-96,13,-11,648768,78,12,1

OK
]]
result = parser.parse_serving_cell(nsa_sample)
test("mode=NSA", result.mode == "NSA")
test("LTE anchor present", result.lte ~= nil)
test("nr pci=920", result.nr5g and result.nr5g.pci == 920)
-- NSA tail is <rsrp>,<sinr>,<rsrq> — deliberately NOT the SA order
test("nr rsrp=-96", result.nr5g and result.nr5g.rsrp == -96)
test("nr sinr=13", result.nr5g and result.nr5g.sinr == 13)
test("nr rsrq=-11", result.nr5g and result.nr5g.rsrq == -11)
print("")

print("Test 14: QCAINFO NR5G PCC (5 fields, standalone)")
local sa_ca = [[
+QCAINFO: "PCC",396250,3,"NR5G BAND 25",484
+QCAINFO: "SCC",125530,3,"NR5G BAND 71",2,484,0,-,-

OK
]]
result = parser.parse_qcainfo(sa_ca)
test("PCC parsed", result.pcc ~= nil)
test("PCC rat=5g", result.pcc and result.pcc.rat == "5g")
test("PCC arfcn=396250", result.pcc and result.pcc.arfcn == 396250)
test("PCC band=25", result.pcc and result.pcc.band == 25)
test("PCC pci=484", result.pcc and result.pcc.pci == 484)
test("one SCC", result.scc and #result.scc == 1)
test("SCC rat=5g", result.scc[1] and result.scc[1].rat == "5g")
test("SCC band=71", result.scc[1] and result.scc[1].band == 71)
print("")

print("Test 16: SA backfill feeds RSRP/SINR into the CA carriers")
-- The actual bug from issue #1: in SA the QCAINFO PCC line carries no
-- signal fields, so unless serving-cell values are backfilled onto it,
-- every consumer (led-bars, watchdog, prometheus) sees rsrp=nil and
-- reports "no signal" on a working link.
local sa_status = {
    serving = parser.parse_serving_cell(sa_single),
    ca = parser.parse_qcainfo(sa_ca),
}
utils.backfill_from_serving(sa_status)
test("PCC rsrp backfilled", sa_status.ca.pcc.rsrp == -108)
test("PCC rsrq backfilled", sa_status.ca.pcc.rsrq == -10)
test("PCC sinr backfilled", sa_status.ca.pcc.sinr == 15)
print("")

print("=== Results ===")
print(string.format("Passed: %d, Failed: %d", passed, failed))

if failed > 0 then
    os.exit(1)
end
